{
  "expo": {
    "name": "sup-app",
    "slug": "sup-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "supapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.supapp.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Sup uses your camera to scan the QR code that pairs your s'pots.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "44T33LV95D"
    },
    "android": {
      "minSdkVersion": 26,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#AB99FA"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.supapp.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.supapp.app",
            "entitlements": {
              "aps-environment": "production"
            },
            "infoPlist": {
              "UIBackgroundModes": [
                "remote-notification"
              ]
            }
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Sup uses your camera to scan the QR code that pairs your s'pots."
        }
      ],
      [
        "react-native-health-connect",
        {
          "healthSharePermission": "Sup uses your step count to track your daily activity."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f46bfcf-9c06-4642-852a-fad20ff13a20"
      }
    }
  }
}
